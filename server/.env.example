PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database configuration
# Option A — cloud Postgres (Neon, Supabase, Railway, etc.): set DATABASE_URL
# and nothing else below. Takes priority over the DB_* vars if both are set.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Option B — local Postgres: leave DATABASE_URL unset, fill these in instead.
# (No SSL is used on this path — do not point it at a cloud DB.)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=uok_connect
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Session secret (backs the short-lived OAuth-flow session only — use a long random 32+ char string)
SESSION_SECRET=super_secret_session_key_replace_me_32chars
# Secret used to derive CSRF tokens (falls back to SESSION_SECRET if unset)
CSRF_SECRET=super_secret_csrf_key_replace_me_32chars

# ── Asgardeo OIDC ────────────────────────────────────────────────────────────
# See README.md "Asgardeo Setup" for exact console steps.
OIDC_ISSUER=https://api.asgardeo.io/t/<your-org>/oauth2/token
OIDC_CLIENT_ID=your_asgardeo_client_id
OIDC_CLIENT_SECRET=your_asgardeo_client_secret
OIDC_REDIRECT_URI=http://localhost:5001/api/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
OIDC_SCOPES=openid profile email offline_access
# Optional: override if Asgardeo's access-token `aud` claim differs from the client ID
# OIDC_AUDIENCE=

# Cloudinary Configuration (for image storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

